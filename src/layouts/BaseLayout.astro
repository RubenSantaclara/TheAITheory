---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import SEO from '../components/SEO.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  keywords?: string[];
  noindex?: boolean;
  pageTitle?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'The AI Theory — Ensayos sobre inteligencia artificial, fundamentos y seguridad',
  description = 'Ensayos y análisis críticos sobre inteligencia artificial: fundamentos, epistemología, seguridad y filosofía de los sistemas inteligentes.',
  canonical,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  keywords,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.theaitheory.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The AI Theory',
  alternateName: 'TheAITheory',
  url: siteUrl,
  inLanguage: 'es-ES',
  description,
  publisher: {
    '@type': 'Organization',
    name: 'The AI Theory',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/logo.svg`,
    },
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'The AI Theory',
  url: siteUrl,
  logo: `${siteUrl}/logo.svg`,
  sameAs: [
    'https://twitter.com/theaitheory',
    'https://linkedin.com/in/theaitheory',
  ],
};

const schemas: Record<string, unknown>[] = [websiteSchema, organizationSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) schemas.push(...jsonLd);
  else schemas.push(jsonLd);
}
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F2FBF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1816" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta http-equiv="x-ua-compatible" content="IE=edge" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      keywords={keywords}
      noindex={noindex}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />

    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://analytics.theaitheory.com/script.js"
        data-website-id="ebd3d4cc-c981-4c67-afb0-9c84fd65ffce"
      ></script>
    )}

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /* Design tokens */
  :root {
    --color-bg: #F2FBF8;
    --color-text: #040606;
    --color-primary: #0F2F26;
    --color-secondary: #1F7A63;
    --color-accent: #34D399;
    --color-surface: #FFFFFF;
    --color-border: #DDEEE8;
    --color-text-muted: #5F6F69;
    --color-text-inverse: #F2FBF8;
    --color-hover: #2BC48A;
    --color-active: #1F7A63;
    --color-btn-bg: #1F7A63;
    --color-btn-text: #F2FBF8;
    --color-btn-hover: #34D399;
  }

  [data-theme="dark"] {
    --color-bg: #0E1816;
    --color-text: #E8F0ED;
    --color-primary: #5EE6B0;
    --color-secondary: #2BC48A;
    --color-surface: #172521;
    --color-border: #24382F;
    --color-text-muted: #A8BDB5;
    --color-text-inverse: #0E1816;
    --color-hover: #6FF0BC;
    --color-active: #2BC48A;
    --color-btn-bg: #2BC48A;
    --color-btn-text: #0E1816;
    --color-btn-hover: #5EE6B0;
  }

  /* Reset & base */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.75;
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: background-color 0.3s ease, color 0.3s ease;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    flex: 1;
  }

  h1, h2, h3, h4 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  :focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Page transitions */
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes fadeOut {
    from { opacity: 1; }
    to   { opacity: 0; }
  }

  ::view-transition-old(root) {
    animation: 200ms ease both fadeOut;
  }
  ::view-transition-new(root) {
    animation: 250ms ease both fadeIn;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }

  /* Botones */
  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: var(--color-btn-bg);
    color: var(--color-btn-text);
    border: 1px solid var(--color-btn-bg);
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
    cursor: pointer;
  }

  .btn:hover {
    background: var(--color-btn-hover);
    border-color: var(--color-btn-hover);
    color: var(--color-btn-text);
  }

  .btn.outline {
    background: transparent;
    color: var(--color-secondary);
    border-color: var(--color-border);
  }

  .btn.outline:hover {
    background: var(--color-surface);
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }
</style>

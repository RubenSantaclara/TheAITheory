---
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The AI Theory',
  description = 'Un blog sobre inteligencia artificial, fundamentos y seguridad.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <ViewTransitions />

    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://analytics.theaitheory.com/script.js"
        data-website-id="ebd3d4cc-c981-4c67-afb0-9c84fd65ffce"
      ></script>
    )}

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /* Design tokens */
  :root {
    --color-bg: #F2FBF8;
    --color-text: #040606;
    --color-primary: #0F2F26;
    --color-secondary: #1F7A63;
    --color-accent: #34D399;
    --color-surface: #FFFFFF;
    --color-border: #DDEEE8;
    --color-text-muted: #5F6F69;
    --color-text-inverse: #F2FBF8;
    --color-hover: #2BC48A;
    --color-active: #1F7A63;
    --color-btn-bg: #1F7A63;
    --color-btn-text: #F2FBF8;
    --color-btn-hover: #34D399;
  }

  [data-theme="dark"] {
    --color-bg: #0E1816;
    --color-text: #E8F0ED;
    --color-primary: #5EE6B0;
    --color-secondary: #2BC48A;
    --color-surface: #172521;
    --color-border: #24382F;
    --color-text-muted: #A8BDB5;
    --color-text-inverse: #0E1816;
    --color-hover: #6FF0BC;
    --color-active: #2BC48A;
    --color-btn-bg: #2BC48A;
    --color-btn-text: #0E1816;
    --color-btn-hover: #5EE6B0;
  }

  /* Reset & base */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.75;
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: background-color 0.3s ease, color 0.3s ease;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  h1, h2, h3, h4 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Page transitions */
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes fadeOut {
    from { opacity: 1; }
    to   { opacity: 0; }
  }

  ::view-transition-old(root) {
    animation: 200ms ease both fadeOut;
  }
  ::view-transition-new(root) {
    animation: 250ms ease both fadeIn;
  }

  /* Botones */
  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: var(--color-btn-bg);
    color: var(--color-btn-text);
    border: 1px solid var(--color-btn-bg);
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
    cursor: pointer;
  }

  .btn:hover {
    background: var(--color-btn-hover);
    border-color: var(--color-btn-hover);
    color: var(--color-primary);
  }

  .btn.outline {
    background: transparent;
    color: var(--color-secondary);
    border-color: var(--color-border);
  }

  .btn.outline:hover {
    background: var(--color-surface);
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }
</style>

---
interface Props {
  title: string;
  date: string;
  tag: string;
  excerpt: string;
  slug: string;
}

const { title, date, tag, excerpt, slug } = Astro.props;

const dateObj = new Date(date);
const formattedDate = dateObj.toLocaleDateString('es', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<a href={`/blog/${slug}`} class="post-item">
  <div class="post-body">
    <div class="post-meta">
      <span class="post-tag">{tag}</span>
      <span class="meta-sep">&middot;</span>
      <time class="post-date" datetime={date}>{formattedDate}</time>
    </div>
    <h2 class="post-title" style={`view-transition-name: post-title-${slug};`}>{title}</h2>
    <p class="post-excerpt">{excerpt}</p>
  </div>
  <span class="post-arrow">-&gt;</span>
</a>

<style>
  .post-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .post-body {
    flex: 1;
    min-width: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .post-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    font-weight: 500;
  }

  .meta-sep {
    color: var(--color-text);
    opacity: 0.5;
    font-size: 0.7rem;
  }

  .post-date {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .post-title {
    font-family: 'Fraunces', serif;
    font-weight: 900;
    font-size: 1.2rem;
    color: var(--color-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.2s;
    margin-bottom: 0.5rem;
  }

  .post-item:hover .post-title {
    color: var(--color-secondary);
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-arrow {
    flex-shrink: 0;
    opacity: 0;
    color: var(--color-secondary);
    transition: opacity 0.2s, transform 0.2s;
    font-size: 1.1rem;
    padding-top: 1.4rem;
  }

  .post-item:hover .post-arrow {
    opacity: 1;
    transform: translateX(4px);
  }
</style>
